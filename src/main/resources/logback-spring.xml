<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <!-- Propriedade com o caminho onde os arquivos de log serão salvos -->
    <property name="LOG_DIR" value="./logs" />

    <!-- Appender para exibir os logs coloridos no console da IDE -->
    <appender name="Console" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- Appender para salvar os logs em um arquivo físico -->
    <appender name="RollingFile" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_DIR}/librarybox.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <!-- Roteamento diário de arquivos de log -->
            <fileNamePattern>${LOG_DIR}/archived/librarybox-%d{yyyy-MM-dd}.log</fileNamePattern>
            <maxHistory>30</maxHistory>
        </rollingPolicy>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- Configuração de nível de log para o seu pacote -->
    <logger name="LibraryBoxTellers.LCRetr0" level="DEBUG" additivity="false">
        <appender-ref ref="Console" />
        <appender-ref ref="RollingFile" />
    </logger>

    <!-- Nível global para o Spring Boot -->
    <root level="INFO">
        <appender-ref ref="Console" />
        <appender-ref ref="RollingFile" />
    </root>

</configuration>